# Veritabanı (boş bırakılırsa backend/eco_profiler.db SQLite dosyası kullanılır)
DATABASE_URL=postgresql+psycopg2://eco:eco@localhost:5432/eco_profiler

# LLM sağlayıcısı: ollama | gemini
LLM_PROVIDER=ollama

# Ollama (yerel)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Gemini (yalnızca LLM_PROVIDER=gemini ise gerekli)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# LLM isteği zaman aşımı (saniye)
LLM_TIMEOUT=300
