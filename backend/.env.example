# Veritabanı (boş bırakılırsa backend/eco_profiler.db SQLite dosyası kullanılır)
DATABASE_URL=postgresql+psycopg2://eco:eco@localhost:5432/eco_profiler

# LLM sağlayıcısı: ollama | gemini
LLM_PROVIDER=ollama

# Ollama (yerel)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Gemini (yalnızca LLM_PROVIDER=gemini ise gerekli)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# LLM isteği zaman aşımı (saniye)
LLM_TIMEOUT=300

# Tahmini enerji etkisi varsayımları (ölçüm değil, tahmin; arayüzde değiştirilebilir)
# İşlemcinin çalışırken çektiği güç (Watt)
CPU_POWER_WATTS=65
# Optimize edilen fonksiyonun günde kaç kez çalıştığı varsayımı
RUNS_PER_DAY=10000

# Yönetici şifresi (desen düzenleme için). Boş bırakılırsa düzenleme kapalıdır.
# Güçlü bir şifre seçin; bu dosyaya gerçek şifreyi yazıp commit'lemeyin (.env kullanın).
ADMIN_PASSWORD=
# Yönetici oturumunun geçerlilik süresi (saat)
ADMIN_TOKEN_HOURS=8
